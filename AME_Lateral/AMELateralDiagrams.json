{
  "$id": "https://raw.githubusercontent.com/mkawahara22/hypar-schemas/main/AME_Lateral/AMELateralDiagrams.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "An object that describes a lateral frame",
  "title": "AMELateralDiagrams",
  "x-namespace": "Elements",
  "type": ["object", "null"],
  "allOf": [{ "$ref": "https://hypar.io/Schemas/Element.json" }],
  "properties": {
    "Walls": {
      "type": "array",
      "description": "Walls represented by base-line endpoints in Hypar global Z-up coordinates (ft).",
      "items": {
        "type": "object",
        "properties": {
          "Name": {
            "type": "string",
            "minLength": 1
          },
          "WallHeightFt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "StartPointFt": {
            "$ref": "https://hypar.io/Schemas/Geometry/Vector3.json"
          },
          "EndPointFt": {
            "$ref": "https://hypar.io/Schemas/Geometry/Vector3.json"
          }
        },
        "required": ["Name", "WallHeightFt", "StartPointFt", "EndPointFt"],
        "additionalProperties": false
      }
    },
    "WallDistributedLoads": {
      "type": "array",
      "description": "Unaggregated uniform distributed loads applied over the full length and height of their referenced wall.",
      "items": {
        "type": "object",
        "properties": {
          "Wall": {
            "type": "string",
            "minLength": 1
          },
          "LoadCase": {
            "type": "string",
            "enum": [
              "D",
              "L",
              "W",
              "E",
              "S",
              "Dcol",
              "Lr",
              "R",
              "SW",
              "W_X_POS_INT_POS",
              "W_X_POS_INT_NEG",
              "W_X_NEG_INT_POS",
              "W_X_NEG_INT_NEG",
              "W_Z_POS_INT_POS",
              "W_Z_POS_INT_NEG",
              "W_Z_NEG_INT_POS",
              "W_Z_NEG_INT_NEG",
              "E_X",
              "E_Z"
            ]
          },
          "LoadDirection": {
            "type": "string",
            "enum": ["Fx", "Fy", "Fz"]
          },
          "LoadMagnitudeKpf": {
            "type": "number"
          }
        },
        "required": ["Wall", "LoadCase", "LoadDirection", "LoadMagnitudeKpf"],
        "additionalProperties": false
      }
    },
    "BuildingSectors": {
      "type": "array",
      "description": "Building-sector roof footprints in Hypar global Z-up coordinates (ft).",
      "items": {
        "type": "object",
        "properties": {
          "SectorId": {
            "type": "string",
            "minLength": 1
          },
          "SectorPolygonFt": {
            "$ref": "https://hypar.io/Schemas/Geometry/Polygon.json"
          }
        },
        "required": ["SectorId", "SectorPolygonFt"],
        "additionalProperties": false
      }
    },
    "RoofMassLoads": {
      "type": "array",
      "description": "Seismic roof loads for building sectors.",
      "items": {
        "type": "object",
        "properties": {
          "SectorId": {
            "type": "string",
            "minLength": 1
          },
          "SeismicRoofLoadKips": {
            "type": "number"
          }
        },
        "required": ["SectorId", "SeismicRoofLoadKips"],
        "additionalProperties": false
      }
    }
  },
  "required": ["Walls", "WallDistributedLoads", "BuildingSectors", "RoofMassLoads"],
  "additionalProperties": false
}
