{
  "$id": "https://raw.githubusercontent.com/mkawahara22/hypar-schemas/main/AMEDeck.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "A Representation of Roof Deck",
  "title": "AME_Deck",
  "x-namespace": "Elements",
  "type": ["object", "null"],
  "allOf": [{ "$ref": "https://hypar.io/Schemas/GeometricElement.json" }],
  "properties": {
    "ReferencePolygon": {
      "description": "The actual roof-deck surface, including cricketed geometry when present.",
      "$ref": "https://hypar.io/Schemas/Geometry/Polygon.json"
