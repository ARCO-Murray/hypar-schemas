    "NonCricketedReferencePolygon": {
      "description": "Optional uncricketed roof-control surface used to establish wall rooflines and panel heights.",
      "$ref": "https://hypar.io/Schemas/Geometry/Polygon.json"
    }
  },
  "additionalProperties": false
}
